{
  "name": "nova-oms-backend",
  "version": "1.0.0-RC1",
  "description": "Backend serverless de Nova OMS — Clean/Hexagonal Architecture + DDD sobre AWS CDK, con arquitectura orientada a eventos (EventBridge + SNS + SQS, patrón Outbox transaccional) y pipeline de CI/CD propio.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/local/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:u": "vitest run tests/unit",
    "test:i": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:openapi": "tsx scripts/generate-openapi.ts",
    "prepare": "husky",
    "cdk": "cdk",
    "lcdk": "cdklocal",
    "lcdkh": "cdklocal deploy --hotswap --profile localstack --require-approval never NovaOmsApiStack",
    "lcdki": "cdklocal bootstrap --profile localstack",
    "lcdkd": "cdklocal deploy --profile localstack --require-approval never NovaOmsApiStack",
    "lcdkde": "cdklocal destroy --profile localstack --require-approval never NovaOmsApiStack",
    "lcdkrd": "pnpm lcdkde && pnpm lcdkd",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy"
  },
  "keywords": [
    "aws",
    "aws-cdk",
    "serverless",
    "lambda",
    "typescript",
    "hexagonal-architecture",
    "ddd",
    "event-driven",
    "outbox-pattern",
    "prisma",
    "postgresql"
  ],
  "author": "Adrian Suarez <adriansuarezucv@gmail.com>",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-cdk": "^2.1129.0",
    "aws-cdk-local": "^3.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prisma": "7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.1",
    "zod-openapi": "^6.0.2"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.33.1",
    "@aws-lambda-powertools/metrics": "^2.33.1",
    "@aws-lambda-powertools/tracer": "^2.33.1",
    "@aws-sdk/client-cognito-identity-provider": "^3.1096.0",
    "@aws-sdk/client-eventbridge": "^3.1101.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-secrets-manager": "^3.1095.0",
    "@aws-sdk/client-ses": "^3.1115.0",
    "@aws-sdk/client-sqs": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "aws-cdk-lib": "^2.260.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-xray-sdk-core": "^3.12.0",
    "bcryptjs": "^3.0.3",
    "cockatiel": "^4.0.0",
    "constructs": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.0.1",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
